# Copy to your environment (Apache SetEnv, php.ini, or a loader you use).
# Password reset: SMTP is used when MAIL_HOST is set; otherwise PHP mail() is used.

APP_BASE_URL=https://your-domain.example/public

MAIL_FROM_ADDRESS=noreply@your-domain.example
MAIL_FROM_NAME=WPU Clearance System

# SMTP (PHPMailer) — set MAIL_HOST to enable
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=your-app-password

# Optional: 1–4 for troubleshooting SMTP (logs to output; use only in dev)
# MAIL_SMTP_DEBUG=2
