RewriteEngine On

# Block raw access to application internals on subdirectory installs.
RewriteRule ^(storage|src|database|vendor|scripts)/ - [F,L]

# Keep direct files/folders at project root accessible.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route all app requests through the root bootstrap.
RewriteRule ^ index.php [L,QSA]
